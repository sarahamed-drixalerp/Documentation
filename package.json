{
  "name": "aspire-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 3001 --host 127.0.0.1",
    "start:ar": "docusaurus start --port 3001 --host 127.0.0.1 --locale ar",
    "start:en": "docusaurus start --port 3001 --host 127.0.0.1 --locale en",
    "build": "docusaurus build",
    "serve": "docusaurus serve --port 3001 --host 127.0.0.1",
    "serve:i18n": "npm run build && npm run serve",
    "i18n": "npm run serve:i18n",
    "clear": "docusaurus clear",
    "write-translations": "docusaurus write-translations"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0"
  }
}
